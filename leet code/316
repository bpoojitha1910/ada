char* removeDuplicateLetters(char* s) {
    int last[26] = {0}, used[26] = {0};
    int n = strlen(s);

    for (int i = 0; i < n; i++)
        last[s[i] - 'a'] = i;

    char* st = (char*)malloc(n + 1);
    int top = -1;

    for (int i = 0; i < n; i++) {
        char c = s[i];

        if (used[c - 'a']) continue;

        while (top >= 0 &&
               st[top] > c &&
               last[st[top] - 'a'] > i)
            used[st[top--] - 'a'] = 0;

        st[++top] = c;
        used[c - 'a'] = 1;
    }

    st[top + 1] = '\0';
    return st;
}
