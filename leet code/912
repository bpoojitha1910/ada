#include <stdlib.h>

void merge(int* a, int l, int m, int r) {
    int i = l, j = m + 1, k = 0;
    int* t = (int*)malloc((r - l + 1) * sizeof(int));

    while (i <= m && j <= r)
        t[k++] = a[i] < a[j] ? a[i++] : a[j++];

    while (i <= m) t[k++] = a[i++];
    while (j <= r) t[k++] = a[j++];

    for (i = l, k = 0; i <= r; i++, k++)
        a[i] = t[k];

    free(t);
}

void sort(int* a, int l, int r) {
    if (l >= r) return;

    int m = (l + r) / 2;

    sort(a, l, m);
    sort(a, m + 1, r);

    merge(a, l, m, r);
}

int* sortArray(int* nums, int numsSize, int* returnSize) {
    sort(nums, 0, numsSize - 1);
    *returnSize = numsSize;
    return nums;
}
