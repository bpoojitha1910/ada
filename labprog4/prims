#include <stdio.h>

#define INF 9999

int main() {
    int n, i, j, u, v, min, cost = 0;

    printf("Enter vertices: ");
    scanf("%d", &n);

    int g[n][n], visited[n], edge = 1;

    printf("Enter adjacency matrix:\n");
    for(i = 0; i < n; i++)
        for(j = 0; j < n; j++)
            scanf("%d", &g[i][j]);

    for(i = 0; i < n; i++) visited[i] = 0;

    visited[0] = 1;

    while(edge < n) {
        min = INF;
        u = v = -1;

        for(i = 0; i < n; i++) {
            if(visited[i]) {
                for(j = 0; j < n; j++) {
                    if(!visited[j] && g[i][j]) {
                        if(g[i][j] < min) {
                            min = g[i][j];
                            u = i;
                            v = j;
                        }
                    }
                }
            }
        }

        printf("%d - %d : %d\n", u, v, min);
        visited[v] = 1;
        cost += min;
        edge++;
    }

    printf("Total cost = %d\n", cost);

    return 0;
}
