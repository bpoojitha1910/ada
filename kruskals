#include <stdio.h>
#include <stdlib.h>

int parent[100];

int find(int i) {
    while (parent[i] != i)
        i = parent[i];
    return i;
}

void union_set(int a, int b) {
    parent[a] = b;
}

int main() {
    int n, e, i, j, a, b, u, v, min, cost = 0;

    printf("Enter vertices and edges: ");
    scanf("%d %d", &n, &e);

    int graph[100][3];

    printf("Enter edges (u v w):\n");
    for (i = 0; i < e; i++)
        scanf("%d %d %d", &graph[i][0], &graph[i][1], &graph[i][2]);

    // sort edges by weight
    for (i = 0; i < e; i++) {
        for (j = i + 1; j < e; j++) {
            if (graph[i][2] > graph[j][2]) {
                int temp[3];
                for (int k = 0; k < 3; k++) {
                    temp[k] = graph[i][k];
                    graph[i][k] = graph[j][k];
                    graph[j][k] = temp[k];
                }
            }
        }
    }

    for (i = 0; i < n; i++)
        parent[i] = i;

    printf("MST edges:\n");

    for (i = 0; i < e; i++) {
        u = find(graph[i][0]);
        v = find(graph[i][1]);

        if (u != v) {
            printf("%d - %d : %d\n", graph[i][0], graph[i][1], graph[i][2]);
            cost += graph[i][2];
            union_set(u, v);
        }
    }

    printf("Total cost = %d\n", cost);

    return 0;
}
